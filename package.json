{
  "name": "estudaai",
  "version": "0.1.1",
  "description": "App de estudos para concurso: anotações, links, gerador de questões por IA e simulados",
  "main": "./out/main/index.js",
  "author": "matheus-vmattos",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && npm test && electron-vite build",
    "build:win": "npm run build && electron-builder --win --publish never",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "dompurify": "^3.3.0",
    "electron": "44.9.3",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "marked": "^17.0.1",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^5.0.2"
  }
}
